config/mat3am_license_secret.txt
config/license_ledger.json
config/license_burns.json
license.dat
**/license.dat

# بيانات تشغيل المطعم (محلية/تجريبية) — لا تُرفع إلا مخطط الصالة المرجعي
config/restaurant/*
!config/restaurant/floor_plan.json

# ملفات build الناتجة (Vite outDir = ui/restaurant) — لا تُرفع
ui/restaurant/assets/
ui/restaurant_build_temp/
build_v33/
dist_v33/

# تقارير/مرفقات محلية
*.pdf
*.docx

# نسخ احتياطية / مخرجات مؤقتة
backups/
tmp_*.json
tmp*.json

